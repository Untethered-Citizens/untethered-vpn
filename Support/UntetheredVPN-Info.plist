<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Untethered VPN uses your local network only while “Add a profile from your phone” is open, so your phone can send a profile to this Apple TV.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Barlow-Regular.ttf</string>
		<string>Barlow-Medium.ttf</string>
		<string>Barlow-SemiBold.ttf</string>
		<string>Barlow-Bold.ttf</string>
		<string>BarlowCondensed-Medium.ttf</string>
		<string>BarlowCondensed-SemiBold.ttf</string>
		<string>BarlowCondensed-Bold.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>UTBackground</string>
		<key>UIImageName</key>
		<string>UTMark</string>
	</dict>
	<key>UVAppGroupID</key>
	<string>$(APP_GROUP_ID)</string>
	<key>UVKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(KEYCHAIN_GROUP)</string>
	<key>UVTunnelBundleID</key>
	<string>$(TUNNEL_BUNDLE_ID)</string>
</dict>
</plist>
